# Privy Configuration
# Get these values from your Privy dashboard: https://dashboard.privy.io
EXPO_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here
EXPO_PUBLIC_PRIVY_CLIENT_ID=your_privy_client_id_here

# Instructions:
# 1. Copy this file to .env
# 2. Replace the placeholder values with your actual Privy credentials
# 3. Never commit the .env file to git